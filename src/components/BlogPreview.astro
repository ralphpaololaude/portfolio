---
import type { CollectionEntry } from 'astro:content';
import PostDate from './PostDate.astro';
import PostTags from './PostTags.astro';
import { Image } from 'astro:assets';

interface Props {
  post: CollectionEntry<'blog'> | CollectionEntry<'projects'>;
}

const { post } = Astro.props;
const { title, description, date, tags, image } = post.data;
const dirName = post.collection;

// Ensure image dimensions are available to prevent CLS
const imageWidth = 800; // Set appropriate default width
const imageHeight = 400; // Set appropriate default height
---

<article class="my-8 p-6 rounded-2xl border border-neutral/20">
  {
  image && (
    <a href={`/${dirName}/${post.id}`} class="block mb-4">
      <Image
        src={image}
        alt={title}
        width={imageWidth}
        height={imageHeight}
        decoding='async'
        loading='eager'
        class="w-full h-48 object-cover rounded-lg shadow-md hover:shadow-lg transition-shadow"
      />
    </a>
  )}
  <header>
    <h2 class="text-2xl font-bold">
      <a href={`/${dirName}/${post.id}`} class="font-serif text-primary-500 hover:text-white transition-all duration-200">
        {title}
      </a>
    </h2>
  {tags && <PostTags tags={tags} />}
  </header>
  <p class="text-white mt-8">{description}</p>
    {post.collection === 'blog' && (
    <div class="mt-6">
      <PostDate date={date} />
    </div>
    )}



</article>