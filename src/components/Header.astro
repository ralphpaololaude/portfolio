---
import { SITE_CONFIG } from "src/config";
import '../styles/global.css';

const { pathname } = Astro.url;

function isActive(href: string) {
    if (href === "/") return false;
  return pathname.startsWith(href);
}

---

<header class="sticky top-0 shadow-md z-50 bg-black">
    <nav class="text-primary flex justify-center p-4">
        <div id="main-menu" class="flex text-primary">
            {SITE_CONFIG.navLinks.map((link) => (
                <a 
                    class="font-(family-name:--font-rugged) text-lg hover:text-white md:px-16 px-4 font-medium transition-all duration-400 ease-in-out"
                    href={link.href} 
                    class:list={isActive(link.href) ? ['text-white', 'font-bold'] : []}
                >
                    {link.text}
                </a>
            ))}
        </div>
    </nav>
</header>