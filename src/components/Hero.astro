---
const { author, description, skills, tools, email, cv } = Astro.props;
import heroEmoji from '@images/emoji.gif?url';

interface Props {
    author: string;
    specialty: string | string[];
    description: string;
    skills: string[];
    tools: string[];
    email: string;
    cv: string;
    }

---

<div class="hero flex flex-1 flex-col items-center justify-center gap-4 text-center">
    <h1 class="font-(family-name:--font-hero) text-primary font-rugged p-4 md:text-6xl text-5xl font-medium text-center">
        {author}
    </h1>
    <p class="text-white md:text-lg text-md">
        {description}
    </p>
    <p class="md:my-10"><img src={heroEmoji} alt="emoji" /></p>


    <div class="flex flex-wrap justify-center md:text-lg text-md mb-5 gap-1">
        {skills.map((skill) => (
                <span class="font-(family-name:--font-rugged) text-primary px-8">
                    {skill}
                </span>
            ))}
    </div>
    <div class="flex flex-wrap justify-center md:mb-8 mb-5 gap-1 md:text-sm text-xs">
        {
            tools.map((tool) => (
                <span class="bg-complement/50 text-white px-3 py-1 rounded-full font-mono">
                    {tool}
                </span>
            ))
        }
    </div>
    <div class="flex flex-wrap justify-center gap-3 my-5">
        <a
            href={`mailto:${email}`}
            class="inline-flex items-center justify-center rounded border border-primary-400 px-5 py-2.5 text-primary-300 md:text-base text-sm transition-colors hover:bg-primary-500 hover:text-white"
        >
            Get in touch
        </a>
        <a
            href={`${import.meta.env.BASE_URL}docs/${cv}`}
            download
            class="inline-flex items-center justify-center rounded bg-primary-500 px-5 py-2.5 text-white md:text-base text-sm transition-colors hover:bg-complement"
        >
            Download CV
        </a>
    </div>
</div>