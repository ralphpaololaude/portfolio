---
const { post } = Astro.props;
import PostDate from '@components/PostDate.astro';
import PostTags from '@components/PostTags.astro';
---

<div
    class="prose prose-lg
    prose-headings:text-primary-400
    prose-p:text-white
    prose-a:text-primary-600
    prose-strong:text-primary-300
    prose-code:text-white
    prose-code:text-wrap
    prose-blockquote:text-primary-700
    prose-pre:prose-code:text-primary
    prose-span:text-primary-700
    prose-li:text-white
    prose-td: text-white
    my-10
    "
    >
    <p class="pb-0.5 flex text-sm text-white/40 gap-2">
        <PostDate date={post.data.date} />
    </p>
    <h1 class="my-5 text-primary text-4xl">{post.data.title}</h1>
    <p class="pb-0.5 flex text-sm text-white/40 gap-2">
        {post.data.tags && <PostTags tags={post.data.tags} />}
    </p>

    <slot/>
</div>