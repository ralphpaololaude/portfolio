---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap gap-2 my-2">
  {tags.map((tag) => (
    <a
      href={`/tags/${tag}`}
      class="tag text-sm px-3 py-1 bg-secondary rounded-full border border-secondary-foreground/30 transition-all duration-400 hover:bg-primary-muted"
    >
      {tag}
    </a>
  ))}
</div>

<style is:global>
  a.tag {
    color: var(--color-secondary-foreground);
    text-decoration: none;
  }
</style>