---
const { author, description, specialty, skills, email, cv } = Astro.props;
import { Image } from 'astro:assets';
import heroEmoji from '@images/emoji.gif?url';

interface Props {
    author: string;
    specialty: string | string[];
    description: string;
    skills: string[];
    email: string;
    cv: string;
    }

---

<div class="hero flex flex-1 flex-col items-center justify-center gap-4 text-center">
    <h1 class="font-(family-name:--font-header) text-primary font-rugged p-4 md:text-6xl text-5xl font-medium text-center">
        {author}
    </h1>
    <div class="flex flex-wrap justify-center gap-2">
        {Array.isArray(specialty) ? (
            specialty.map((item) => (
                <h3 class="font-(family-name:--font-rugged) text-primary text-xl px-3 py-1">
                    {item}
                </h3>
            ))
        ) : (
            <h3 class="font-(family-name:--font-rugged) text-primary text-xl px-3 py-1">
                {specialty}
            </h3>
        )}
    </div>
    <p class="text-white md:text-base text-sm">
        {description}
    </p>
    <p><img src={heroEmoji} alt="emoji" /></p>
    <div class="flex flex-wrap justify-center my-8 gap-2 md:text-base text-sm">
        {
            skills.map((skill) => (
                <span class="bg-primary-700/50 text-white px-3 py-1 rounded-full">
                    {skill}
                </span>
            ))
        }
    </div>
    <div class="flex flex-wrap justify-center gap-3">
        <a
            href={`mailto:${email}`}
            class="inline-flex items-center justify-center rounded border border-primary-400 px-5 py-2.5 text-primary-300 md:text-base text-sm transition-colors hover:bg-primary-500 hover:text-white"
        >
            Send an email
        </a>
        <a
            href={`${import.meta.env.BASE_URL}docs/${cv}`}
            download
            class="inline-flex items-center justify-center rounded bg-primary-500 px-5 py-2.5 text-white md:text-base text-sm transition-colors hover:bg-primary-400"
        >
            Download CV
        </a>
    </div>
</div>