---
import Menu from '../components/Menu.astro';
import { SITE_CONFIG } from "src/config";
import '../styles/global.css';

---

<header class="shadow-md md:top-0 md:z-50 bg-black">
    <nav class="text-primary flex justify-center p-5">
        <div id="main-menu" class="flex text-primary">
            {SITE_CONFIG.navLinks.map((link) => (
                <a 
                    class="font-(family-name:--font-rugged) text-lg hover:text-white md:px-12 px-7 font-medium transition-all duration-400 ease-in-out"
                    href={link.href} 
                    >
                    {link.text}
                </a>
            ))}
        </div>
    </nav>
</header>