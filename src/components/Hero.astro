---
const { author, description, skills, tools, email, cv } = Astro.props;
import heroEmoji from '@images/emoji.gif?url';

interface Props {
    author: string;
    specialty: string | string[];
    description: string;
    skills: string[];
    tools: string[];
    email: string;
    cv: string;
    }

---

<div class="hero flex flex-1 flex-col items-center justify-center gap-4 text-center">
    <h1 class="font-(family-name:--font-hero) text-primary font-rugged py-12 md:text-6xl text-5xl font-medium text-center">
        {author}
    </h1>
    <p class="text-foreground md:text-lg text-md">
        {description}
    </p>
    
    <p class=""><img src={heroEmoji} alt="emoji" /></p>


    <div class="flex flex-wrap justify-center md:text-lg text-md mb-5 gap-1">
        {skills.map((skill) => (
                <span class="font-(family-name:--font-rugged) text-primary-muted px-8">
                    {skill}
                </span>
            ))}
    </div>
    <div class="flex flex-wrap justify-center md:mb-8 mb-5 gap-1 md:text-sm text-xs">
        {
            tools.map((tool) => (
                <span class="text-sm px-3 py-1 bg-secondary text-secondary-foreground rounded-full border border-secondary-foreground/30 font-mono">
                    {tool}
                </span>
            ))
        }
    </div>
    <div class="flex flex-wrap justify-center gap-3 my-5">
        <a
            href={`mailto:${email}`}
            class="inline-flex items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-black md:text-base text-sm transition-colors hover:bg-secondary-foreground"

        >
            Get in touch
        </a>
        <a
            href={`${import.meta.env.BASE_URL}docs/${cv}`}
            download
            class="inline-flex items-center justify-center rounded-lg border border-primary px-5 py-2.5 text-primary md:text-base text-sm transition-colors hover:border-secondary-foreground hover:text-secondary-foreground"            
        >
            Download CV
        </a>
    </div>
</div>