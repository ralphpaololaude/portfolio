---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap gap-2 my-2">
  {tags.map((tag) => (
    <a
      href={`/tags/${tag}`}
      class="tag text-sm px-3 py-1 text-white bg-complement/60 rounded-full transition-all duration-400 hover:bg-primary-300/50"
    >
      {tag}
    </a>
  ))}
</div>

<style is:global>
  a.tag {
    color: var(--color-white);
    text-decoration: none;
  }
</style>