---
import Section from "./Section.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Work Experience" href="experience">
  {
    experience.map(({ company, position, startDate, endDate, summary }) => (
      <div class="bg-surface my-8 p-6 rounded-2xl ring-1 ring-primary-muted/30">
        <h3 class="mb-1.5 font-serif text-2xl font-semibold text-foreground">
          {company}
        </h3>
        <div class="flex flex-col items-start pb-5">
          <h4 class="mb-0.5 font-mono text-xl font-medium text-primary">
            {position}
          </h4>
          <span class="pb-0.5 text-sm text-foreground-muted">
            {startDate} — {endDate}
          </span>
        </div>
        {Array.isArray(summary) ? (
          <ul class="list-none">
            {summary.map((log) => (
              <li class="relative mb-3 text-base text-foreground">
                {log}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base text-foreground">{summary}</p>
        )}
      </div>
    ))
  }
</Section>