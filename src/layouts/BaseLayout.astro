---
import '../styles/global.css';
import { Font } from "astro:assets";
import { ClientRouter, slide } from 'astro:transitions';

const { pageTitle } = Astro.props
const isHomePage = Astro.url.pathname === '/';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import BackToTop from '@components/BackToTop.astro';

---


<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} >
    <Font cssVariable="--font-rugged" />
    <Font cssVariable="--font-hero" />
    <Font cssVariable="--font-content" />
    <Font cssVariable="--font-header" />
    <Font cssVariable="--font-code" />
    
    <ClientRouter />

    <title>{pageTitle}</title>
  </head>

  <body class:list={['bg-background flex flex-col', isHomePage ? 'h-dvh overflow-hidden' : 'min-h-screen']}>
    <Header transition:persist />
    <div class="flex flex-1 min-h-0 flex-col max-w-3xl w-full mx-auto px-4 sm:px-6">
      <main class="flex flex-1 min-h-0 flex-col gap-8" transition:animate={slide({ duration: '.3s' })}>
        <slot />
      </main>
      <BackToTop />
    </div>
    <Footer transition:persist />
  </body>
</html>