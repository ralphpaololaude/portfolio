---
const { post } = Astro.props;
import PostDate from '@components/PostDate.astro';
import PostTags from '@components/PostTags.astro';
---

<div
    class="prose prose-lg
    prose-headings:text-primary
    prose-headings:font-serif
    prose-p:text-foreground
    prose-a:text-primary
    prose-strong:text-primary
    prose-code:text-foreground
    prose-code:text-wrap
    prose-blockquote:text-primary
    prose-pre:prose-code:text-primary
    prose-span:text-primary
    prose-li:text-foreground
    prose-td: text-foreground
    my-10
    "
    >
    <p class="pb-0.5 flex text-sm gap-2">
        <PostDate date={post.data.date} />
    </p>
    <h1 class="my-5 text-primary text-4xl">{post.data.title}</h1>
    <p class="pb-0.5 flex text-sm text-foreground/40 gap-2">
        {post.data.tags && <PostTags tags={post.data.tags} />}
    </p>
    {post.collection === 'projects' && (
        <div>
            <p class="text-foreground">{post.data.description}</p>
        </div>
    )}

    <slot/>
</div>