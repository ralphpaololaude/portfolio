---
import { SITE_CONFIG } from "src/config";
import { Icon } from "astro-icon/components";

interface Props {
  iconButtons?: boolean;
}

const { iconButtons = false } = Astro.props;
---
 
 <ul class:list={iconButtons
    ? "flex flex-nowrap items-center gap-2"
    : "mb-2 flex flex-wrap justify-center gap-x-5 text-xs"}>
    {
      SITE_CONFIG.socialLinks.map(({ href, icon }) => (
        <li>
          <a
            href={href}
            target="_blank"
            class:list={iconButtons
              ? "inline-flex h-10 w-10 items-center justify-center rounded-full border border-primary/40 bg-surface/50 text-primary-muted transition-colors duration-200 hover:border-secondary-foreground hover:bg-secondary/40 hover:text-secondary-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary-foreground"
              : "inline-block px-4 text-primary-muted transition-all duration-500 after:relative after:-bottom-1 hover:text-secondary-foreground"}
            aria-label={`Link to ${icon} profile`}
          >
            <Icon name={icon} size="24"/>
          </a>
          
        </li>
      ))
    }
  </ul>