---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {tags.map((tag) => (
    <a
      href={`/tags/${tag}`}
      class="text-sm px-3 py-1 text-white bg-gray-700/60 rounded-full transition-all  hover:bg-gray-300/50 hover:text-primary-600"
    >
      #{tag}
    </a>
  ))}
</div>
