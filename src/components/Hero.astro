---
const { author, description, skills, tools, email, cv } = Astro.props;
import heroEmoji from '@images/emoji.gif?url';
import { TypingAnimation } from "@ui/typing-animation"

interface Props {
    author: string;
    specialty: string | string[];
    description: string;
    skills: string[];
    tools: string[];
    email: string;
    cv: string;
    }

---

<div class="hero flex flex-1 flex-col items-center justify-center gap-4 text-center pt-12 px-6">
    <h1 class="font-(family-name:--font-hero) text-primary font-rugged px-4 py-2 md:text-6xl text-5xl font-medium text-center">
        {author}
    </h1>
    
    <div class="mt-0 md:mb-5 mb-10">
        <TypingAnimation client:load
        words={skills}
        className="font-(family-name:--font-rugged) text-foreground text-lg lg:text-lg px-8"
        loop={true}
        typeSpeed={75}
        cursorStyle="underscore"
        />
    </div>

    <p class="md:my-5 mb-10"><img src={heroEmoji} alt="emoji" /></p>

    <div class="flex flex-wrap justify-center gap-x-2 gap-y-2.5 mb-10 md:text-sm text-xs">
        {
            tools.map((tool) => (
                <span class="text-sm px-3 py-1 bg-secondary text-secondary-foreground rounded-full border border-secondary-foreground/30 font-mono">
                    {tool}
                </span>
            ))
        }
    </div>
    <div class="flex flex-wrap justify-center flex gap-4 mb-12">
        <a
            href={`mailto:${email}`}
            class="inline-flex items-center justify-center rounded-lg bg-primary px-5 py-2.5 text-black md:text-base text-sm transition-colors hover:bg-secondary-foreground"

        >
            Get in touch
        </a>
        <a
            href={`${import.meta.env.BASE_URL}docs/${cv}`}
            download
            class="inline-flex items-center justify-center rounded-lg border border-primary px-5 py-2.5 text-primary md:text-base text-sm transition-colors hover:border-secondary-foreground hover:text-secondary-foreground"            
        >
            Download CV
        </a>
    </div>
</div>


