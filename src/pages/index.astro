---
import Layout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import { SITE_CONTENT } from "src/config";

const {
  hero
} = SITE_CONTENT;
---
<Layout pageTitle={`Portfolio | ${hero.name}`}>
  <Hero author={hero.name} description={hero.summary} specialty={hero.specialty} skills={hero.skills} tools={hero.tools} email={hero.email} cv={hero.cv} />
</Layout>